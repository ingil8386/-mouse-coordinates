<Window x:Class="MouseMacro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MouseMacro"
        mc:Ignorable="d"
        Title="MouseMacro" Height="350" Width="600" WindowStyle="SingleBorderWindow">
    <Window.InputBindings>
        <KeyBinding Key="F2" Command="{Binding StopMacroCommand}" />
    </Window.InputBindings>
    <Grid Background="PowderBlue">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        
        

        <Grid Grid.Column="1">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Label x:Name="RepeatCountLabel">반복 횟수 :</Label>

                <ListBox x:Name="CoordinatesListBox" Width="155" Height="180" />

                <DockPanel Height="55"  Width="170">
                    <Button x:Name="AddBtn"    Click="AddBtn_Click"    Margin="3" Width="50" Height="30">Insert</Button>
                    <Button x:Name="DeleteBtn" Click="DeleteBtn_Click" Margin="3" Width="50" Height="30">Delete</Button>
                    <Button x:Name="Clear"     Click="ClearBtn_Click"  Margin="3" Width="50" Height="30">Clear</Button>
                </DockPanel>
            </StackPanel>
       
        </Grid>



        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" Height="200" Margin="17,60,13,59" Width="120">
            <Button x:Name="CoordinateBtn"  Width="100" Height="30" Margin="10" Click="CoordinateBtn_Click">좌표지정(Enter)</Button>
            <Button x:Name="StartBtn" Width="100" Height="30" Margin="10" Click="StartBtn_Click">실행</Button>
            <Button x:Name="StopBtn"  Width="100" Height="30" Margin="10" Click="StopBtn_Click" >중지(Alt + X)</Button>
            <Button x:Name="ExitBtn"  Width="100" Height="30" Margin="10" Click="ExitBtn_Click">종료</Button>
        </StackPanel>


    </Grid>
</Window>
