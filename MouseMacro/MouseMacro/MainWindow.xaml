<Window x:Class="MouseMacro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MouseMacro"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Title="MouseMacro" Height="600" Width="700" WindowStyle="None"  Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Dictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>


    <Grid Style="{StaticResource GridStyle}" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="201*"/>
            <ColumnDefinition Width="145*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="37*"/>
            <RowDefinition Height="17*"/>
            <RowDefinition Height="242*"/>

        </Grid.RowDefinitions>


        <!--// <Image Source="icon/back.png" Stretch="UniformToFill"   Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Grid.RowSpan="2" MouseLeftButtonDown="Image_MouseLeftButtonDown"/>
       // <Image Source="icon/sky.png" Stretch="UniformToFill"  Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2"/>-->

        <Canvas x:Name="MainCanvas"
                 Height="600" Width="700"
                Background="Transparent"
                Panel.ZIndex="25"
                MouseLeftButtonDown="OnCanvasMouseLeftButtonDown" Grid.RowSpan="3" Margin="-8,-8,0,0" Grid.ColumnSpan="2" >
            <!-- 중앙 흰색 원 -->


            <Ellipse x:Name="CenterEllipse" Panel.ZIndex="9999"
                     Fill="White"
                     Stroke="White"
                     StrokeThickness="1"
                     Visibility="Collapsed"
                     Opacity="0"
                     Canvas.Left="100"
                     Canvas.Top="100"
                     Width="50"
                     Height="50"/>

            <!-- 중간 크기의 원 -->
            <Ellipse x:Name="RippleEllipse" Panel.ZIndex="9999"
                     Fill="Transparent"
                     Stroke="White"
                     StrokeThickness="1"
                     Visibility="Collapsed"
                     Opacity="1"
                     Canvas.Left="75"
                     Canvas.Top="75"
                     Width="100"
                     Height="100"/>

            <!-- 가장 큰 원 -->
            <Ellipse x:Name="OuterEllipse" Panel.ZIndex="9999"
                     Fill="Transparent"
                     Stroke="White"
                     StrokeThickness="1"
                     Visibility="Collapsed"
                     Opacity="0"
                     Canvas.Left="50"
                     Canvas.Top="50"
                     Width="150"
                     Height="150"/>


        </Canvas>

        <Image Source="icon/aaa.png" Grid.Column="0"  Grid.Row="1" Grid.ColumnSpan="2" Grid.RowSpan="3" Stretch="UniformToFill"  />


        <!--// <Image Source="icon/back.png" Stretch="UniformToFill"   Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Grid.RowSpan="2" MouseLeftButtonDown="Image_MouseLeftButtonDown"/>
       // <Image Source="icon/sky.png" Stretch="UniformToFill"  Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2"/>-->

        <Grid Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Grid.RowSpan="2">
            <Frame x:Name="HelpFrame"
                NavigationUIVisibility="Hidden">
                <!-- Frame의 내용 -->

            </Frame>

        </Grid>

        <Image Source="icon/sky.png"  Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Stretch="UniformToFill"  />


        <!-- 중앙 컨텐츠 -->
        <DockPanel Grid.Column="1" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Right" Height="30" Width="200"  x:Name="serve_panel">
            <Label x:Name="RepeatCountLabel" Content="Cycle : 0" Style="{StaticResource LabelStyle}" Width="70"/>
            <Label x:Name="IntervalLavel"       Content="{Binding Interval, StringFormat='Interval : {0} ms'}"  Style="{StaticResource LabelStyle}" Width="91" />

        </DockPanel>
        <!-- 좌표 리스트 및 버튼 -->

        <StackPanel x:Name="MainPanel" VerticalAlignment="Bottom" HorizontalAlignment="Center"   Grid.Row="2" Height="404"  Width="308" Margin="47,0,47,63" Panel.ZIndex="50">
            <Label x:Name="PositionLabel" Style="{StaticResource LabelStyle}"/>
            <ListBox x:Name="CoordinatesListBox" Height="264" Width="287" Style="{StaticResource CustomListBoxStyle}"/>

            <DockPanel HorizontalAlignment="Center" Panel.ZIndex="9999">
                <Button x:Name="AddBtn" Click="AddBtn_Click" Style="{StaticResource InsertStyle}" Height="50" Width="50"/>
                <Button x:Name="DeleteBtn" Click="DeleteBtn_Click" Style="{StaticResource DeleteStyle}" Height="50" Width="50"/>
                <Button x:Name="Clear" Click="ClearBtn_Click" Style="{StaticResource ClearStyle}" Width="50" Content="Clear" Height="50"/>
                <Button x:Name="StartBtn" Click="StartBtn_Click" Style="{StaticResource StartStyle}" Content="실행" Height="50" Width="50" />
                <Button x:Name="StopBtn" Click="StopBtn_Click" Style="{StaticResource StopStyle}" Content="중지(Alt + X)"  Width="50" Height="50"/>

            </DockPanel>
        </StackPanel>


        <!-- 좌표 지정 및 제어 버튼 -->
        <DockPanel Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" Panel.ZIndex="9999">
            <DockPanel  Grid.Column="0" Grid.Row="1" HorizontalAlignment="Left" >
                <Button x:Name="LoadBtn" Click="LoadBtn_Click" Style="{StaticResource LoadStyle}" Height="55" Content="불러오기" Width="52" Margin="20,0,0,0"/>
                <Button x:Name="SaveBtn" Click="SaveBtn_Click" Style="{StaticResource SaveStyle}" Height="50" Content="저장" Width="50"/>
            </DockPanel>
            <DockPanel Grid.Column="1" Grid.Row="1" HorizontalAlignment="Right" >
                <Button x:Name="SetBtn" Click="SetBtn_Click" Style="{StaticResource SetStyle}" Content="환경설정" Width="57" Margin="0,8,5,10" RenderTransformOrigin="0.5,0.5">
                </Button>
                <Button x:Name="HelpBtn" Click="HelpBtn_Click" Style="{StaticResource HelpStyle}" Content="도움말"  Width="58" Margin="0,2,5,5" />
                <Button x:Name="ExitBtn" Click="ExitBtn_Click" Style="{StaticResource ExitStyle}" Content="종료"  Width="55" Margin="0,10,5,13"/>
            </DockPanel>
        </DockPanel>

    </Grid>
</Window>
