<Page x:Class="MouseMacro.HelpPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MouseMacro"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="HelpPage">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Dictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Image Source="icon/dimi.png" Stretch="UniformToFill"   Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Grid.RowSpan="2"/>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            <StackPanel Margin="10">
                <Label Foreground="black" FontWeight="Bold">[사용법]</Label>
                <Label Foreground="black" FontWeight="Bold">1.   + 버튼으로 좌표를 지정합니다</Label>
                <Label Foreground="black" FontWeight="Bold">2.   - 버튼으로 잘못 입력된 좌표를 제거하거나 초기화 버튼으로 모두 삭제합니다</Label>
                <Label Foreground="black" FontWeight="Bold">3.   좌표입력이 모두 끝나면 ▷ 버튼으로 매크로를 실행합니다</Label>
                <Label Foreground="black" FontWeight="Bold">4.   매크로를 정지시키고 싶을 경우 단축키 Alt+x 를 누르거나  | | 버튼을 클릭합니다</Label>
            </StackPanel>

            <StackPanel Margin="10">
                <Label Foreground="black"  FontWeight="Bold">[저장방법]</Label>
                <Label Foreground="black"  FontWeight="Bold">1.   저장 버튼으로 현재 리스트에 입력된 좌표를 txt파일로 저장합니다</Label>
                <Label Foreground="black"  FontWeight="Bold">2.   추후 저장된 좌표를 다시 실행시키고 싶을경우 폴더버튼을 눌러 저장된 좌표를 불러옵니다</Label>
            </StackPanel>                     
            <StackPanel Margin="10">
                <Label Foreground="black"  FontWeight="Bold">[시간 간격설정(Interval)]</Label>
                <Label Foreground="black" FontWeight="Bold">   톱니바퀴 모양의 설정버튼을 클릭합니다</Label>
                <Label Foreground="black"  FontWeight="Bold">   변경하고싶은 시간 간격 단위입력합니다 , (밀리초, ms)  ex) 1초 = 1000밀리초</Label>
                <Label Height="10"> </Label>
   
            </StackPanel>

            <Button x:Name="ExitBtn" Click="ExitBtn_Click" Content="Close" Background="White" Foreground="SteelBlue"  FontWeight="Bold" BorderThickness="1" BorderBrush="White" Width="100" Height="30">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5" 
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

        </StackPanel>
       
        

    </Grid>

</Page>
