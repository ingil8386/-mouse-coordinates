<Window x:Class="MouseMacro.Setting"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MouseMacro"
        mc:Ignorable="d"
        Title="Setting" Height="450" Width="800">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Label x:Name="CurrentIntervalLabel" Content="설정되지 않음" Width="200" Height="30" Margin="10" />
            <TextBox x:Name="TimeIntervalTextBox" Width="200" Height="30" Margin="10" />
            <Button Content="시작" Width="100" Height="30" Click="Button_Click" />
        </StackPanel>

    </Grid>
</Window>
